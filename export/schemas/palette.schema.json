{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "palette.schema.json",
  "title": "palette.json",
  "type": "object",
  "required": ["crime_types", "labels_fr", "colors", "clusters", "neutral", "source"],
  "properties": {
    "crime_types": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "labels_fr": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "colors": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
    },
    "neutral": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "source": {"type": "string"}
  },
  "additionalProperties": false
}
