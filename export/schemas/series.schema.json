{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "series.schema.json",
  "title": "series.json",
  "type": "object",
  "required": ["quarters", "city", "city_by_type", "boroughs"],
  "properties": {
    "quarters": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "city": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "city_by_type": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "integer", "minimum": 0}
      }
    },
    "boroughs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "integer", "minimum": 0}
      }
    }
  },
  "additionalProperties": false
}
